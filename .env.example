# ── Required ─────────────────────────────────────────────────────────────────
# Your AMION schedule login ID (e.g. "gmesamc!")
AMION_ID=

# Resend API key — get from https://resend.com/api-keys
RESEND_API_KEY=

# ── Recommended ───────────────────────────────────────────────────────────────
# A random secret string used to protect the weekly-report cron endpoint.
# Set the same value in Vercel under Settings → Environment Variables.
# Vercel Cron automatically sends this as:  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
